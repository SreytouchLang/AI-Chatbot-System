APP_NAME=AI Chatbot System
APP_VERSION=2.0.0
APP_DESCRIPTION=Document and media-aware chatbot with FastAPI, LangGraph, Redis memory, Chroma retrieval, and transcription support. Developed by Sreytouch Lang (Jessica).
DEVELOPER_NAME=Sreytouch Lang
DEVELOPER_DISPLAY_NAME=Sreytouch Lang (Jessica)

OPENAI_API_KEY=your_api_key_here
LANGSMITH_TRACING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

VECTOR_COLLECTION_NAME=policies
VECTOR_PERSIST_DIRECTORY=./chroma_db

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

RETRIEVE_TOP_K=3
RECENT_MESSAGE_WINDOW=6
SUMMARY_TRIGGER_MESSAGES=4
SUMMARY_MAX_LINES=4

INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
DOWNLOAD_TIMEOUT_SECONDS=30
